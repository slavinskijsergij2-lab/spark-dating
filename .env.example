# ─────────────────────────────────────────────────────────────────────────────
# Spark Dating — Railway Environment Variables
# Скопируй эти переменные в Railway → Variables и заполни значения.
# Не коммить реальные значения в git!
# ─────────────────────────────────────────────────────────────────────────────

# ── ОБЯЗАТЕЛЬНЫЕ ─────────────────────────────────────────────────────────────

# Секретный ключ для JWT токенов (min 32 символа, случайный)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замени-на-случайную-строку-минимум-32-символа

# URL базы данных (Railway добавляет автоматически при добавлении PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Публичный URL сайта (без слэша в конце)
APP_URL=https://spark-dating.club
SITE_URL=https://spark-dating.club

# ── EMAIL (Resend) ────────────────────────────────────────────────────────────

# API ключ от resend.com (бесплатно: 100 писем/день)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# От кого отправляется письмо (после верификации домена в Resend)
# Пока домен не верифицирован — оставь onboarding@resend.dev
RESEND_FROM=Spark <noreply@spark-dating.club>

# ── МОНИТОРИНГ ОШИБОК (Sentry) ───────────────────────────────────────────────

# DSN из sentry.io → Projects → твой проект → Settings → Client Keys
# Без этого ошибки в продакшне невидимы!
SENTRY_DSN=https://xxxxx@o0000000.ingest.sentry.io/0000000

# ── ФОТО (Railway Volume) ────────────────────────────────────────────────────

# Путь к Volume для хранения фото пользователей (переживает редеплои)
# Шаг 1: Railway → твой сервис → Volumes → Add Volume → Mount Path: /data/photos
# Шаг 2: Добавь эту переменную:
PHOTO_DIR=/data/photos

# ── REDIS (опционально, но рекомендуется) ────────────────────────────────────

# Railway → Add Service → Redis → скопируй REDIS_URL
# Без Redis: rate limiting работает in-memory (сбрасывается при рестарте)
REDIS_URL=redis://default:password@host:6379

# ── STRIPE (для premium подписки) ────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxx

# ── GOOGLE PLAY BILLING (премиум в Android-приложении / TWA) ─────────────────
# Пакет приложения в Play Console
PLAY_PACKAGE_NAME=club.spark_dating.twa
# ID товаров из Play Console → Монетизация: подписка и разовая покупка
PLAY_SKU_MONTHLY=premium_monthly
PLAY_SKU_LIFETIME=premium_lifetime
# JSON-ключ сервисного аккаунта Google Cloud (целиком или в base64);
# в Play Console → Пользователи и разрешения дай ему доступ к финансовым данным
PLAY_SERVICE_ACCOUNT_JSON=
# Секрет для Pub/Sub push: https://spark-dating.club/billing/play/rtdn?token=<этот секрет>
PLAY_RTDN_TOKEN=
# SHA-256 ключа подписи приложения (Play Console → Целостность приложения), через запятую
ANDROID_CERT_SHA256=

# ── PUSH-УВЕДОМЛЕНИЯ (Web Push) ──────────────────────────────────────────────

# Генерация: python3 -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print('PUBLIC:', v.public_key); print('PRIVATE:', v.private_key)"
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_CLAIMS_EMAIL=mailto:slavinskijsergij2@gmail.com

# ── АДМИНИСТРИРОВАНИЕ ────────────────────────────────────────────────────────

# Email для алертов при падении сервера
ADMIN_EMAIL=slavinskijsergij2@gmail.com

# Токен для защищённых эндпоинтов /metrics и /sentry-debug
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(16))"
METRICS_TOKEN=замени-на-случайный-токен

# Коды для активации Premium вручную (через запятую)
PREMIUM_CODES=

# ── RAILWAY (устанавливается автоматически) ───────────────────────────────────
# Эти переменные Railway добавляет сам — не трогай:
# RAILWAY_ENVIRONMENT=production
# PORT=xxxx
